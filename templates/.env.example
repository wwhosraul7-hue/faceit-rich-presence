# ID-ul aplicației Discord (Discord Developer Portal -> aplicația ta -> General Information -> Application ID)
DISCORD_CLIENT_ID=

# Cheia ta API de la FACEIT (Server-side / API Key) - de la https://developers.faceit.com/
FACEIT_API_KEY=

# Nickname-ul tău exact de pe FACEIT
FACEIT_NICKNAME=

# La cate secunde se verifica statusul FACEIT (elo/nivel/ultimul meci). Implicit 20.
POLL_INTERVAL_SECONDS=20

# Portul pe care ruleaza serverul local care primeste date live de la CS2 (GSI). Implicit 3000.
GSI_PORT=3000

# Token secret - trebuie sa fie IDENTIC cu cel din gamestate_integration_faceitrpc.cfg
GSI_AUTH_TOKEN=schimba-acest-token
