{
  "name": "faceit-rpc",
  "version": "1.0.0",
  "description": "FACEIT Discord Rich Presence",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/index.js",
    "electron": "electron .",
    "dist": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis",
    "dist:all": "electron-builder --win nsis portable"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.faceitrpc.tray",
    "productName": "FaceitRPC",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/sounds/**/*",
      "build/icon.ico",
      "package.json",
      "!node_modules/electron",
      "!node_modules/electron-builder"
    ],
    "asar": true,
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FaceitRPC",
      "artifactName": "FaceitRPC-Setup.exe"
    },
    "portable": {
      "artifactName": "FaceitRPC-Tray.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wwhosraul7-hue",
        "repo": "faceit-rich-presence"
      }
    ],
    "directories": {
      "output": "dist"
    }
  }
}
